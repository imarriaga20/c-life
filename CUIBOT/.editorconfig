root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{js,jsx,ts,tsx,json,css,md}]
indent_size = 2

[*.{bat,cmd,ps1}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

# Scripts originales: se conservan byte por byte
[database/originales/**]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
