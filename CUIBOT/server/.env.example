# ========================================================================
# CUIBOT - Variables de entorno del backend
# Copia este archivo como .env y ajusta los valores si es necesario.
# ========================================================================

PORT=4000

# Base de datos MySQL / MariaDB (XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cuibot_db

# Seguridad
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# Origen permitido del frontend
CLIENT_ORIGIN=http://localhost:5173
