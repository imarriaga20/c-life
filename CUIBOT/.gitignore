# Dependencias y artefactos de build
node_modules/
client/dist/
client/.vite/

# Variables de entorno (nunca subir secretos)
server/.env
.env
.env.local

# Logs
*.log
npm-debug.log*
logs/

# Sistema operativo / editores
.DS_Store
Thumbs.db
desktop.ini
.idea/

# Visual Studio Code: se comparten las tareas y el depurador,
# pero no los archivos personales del editor.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# Evidencias generadas localmente (opcional)
# evidencias/
